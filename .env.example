# Run python scripts/bootstrap.py to create .env with random local secrets.
COMPOSE_PROJECT_NAME=gridsentinel
POSTGRES_DB=gridsentinel
POSTGRES_USER=gridsentinel
POSTGRES_PASSWORD=
DATABASE_URL=
AUTH_SECRET=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
OPERATOR_PASSWORD=
VIEWER_PASSWORD=
SERVICE_TOKEN=
DEVICE_TOKEN=
MQTT_USERNAME=gridsentinel
MQTT_PASSWORD=
MQTT_HOST=mqtt
MQTT_PORT=1883
PANEL_COUNT=100
SIMULATOR_INTERVAL=3
SIMULATOR_MAX_FPS=50
SIMULATOR_FOCUS_INTERVAL=1.5
SCADA_HOST=scada
SCADA_PORT=1502
SCADA_PORT_BASE=1502
SCADA_PORT_END=1504
SCADA_BANK_SIZE=247
SCADA_BANK_COUNT=3
API_URL=http://api:8000
DB_CONNECT_TIMEOUT_SECONDS=3
DB_POOL_TIMEOUT_SECONDS=3
DB_STATEMENT_TIMEOUT_MS=5000
DB_LOCK_TIMEOUT_MS=2000
DB_SOCKET_TIMEOUT_MS=5000
WRITE_LOCK_TIMEOUT_SECONDS=3

# Optional host-only port remapping when Windows reserves 1502..1504 / 1883.
# Container/API ports stay unchanged; host range must have SCADA_BANK_COUNT entries.
# SCADA_HOST_PORT_BASE=11502
# SCADA_HOST_PORT_END=11504
# MQTT_HOST_PORT=11883
